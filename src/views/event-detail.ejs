<div class="max-w-5xl my-10 mx-auto leading-relaxed bg-backgroundmd rounded-2xl p-6 md:p-10 shadow-xl"
     x-data="{ 
        get relativeTime() {
            const start = new Date('<%= event.startDate.toISOString() %>');
            const now = new Date();
            const diffTime = start - now;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays < 0) return ''; 
            if (diffDays === 0) return 'Happening Today';
            if (diffDays === 1) return 'Starting Tomorrow';
            if (diffDays <= 7) return `In ${diffDays} days`;
            return ''; 
        }
     }">
    
    <!-- Responsive Header -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-4 mb-8">
        <div class="flex-1">
            <h1 class="text-4xl md:text-5xl m-0 mb-2 break-all tracking-tight font-bold"><%= event.title %></h1>
            
            <!-- Alpine.js Human Readable Time Label -->
            <template x-if="relativeTime">
                <div x-text="relativeTime" class="text-highlightlt font-bold text-lg md:text-xl uppercase tracking-widest mb-4"></div>
            </template>
            
            <div class="flex flex-wrap gap-3 items-center">
                <% if (isDraft) { %>
                    <span class="text-textlt/90 bg-amber-500/50 py-2 px-4 rounded-full text-base font-bold">⚠️ Draft</span>
                <% } %>
                <span class="bg-green-500/20 text-textlt/90 py-2 px-4 rounded-full text-base font-bold capitalize"><%= event.category %></span>
            </div>
        </div>
        <a href="/events" class="text-highlightlt text-lg font-semibold hover:underline">&larr; Back to Events</a>
    </div>

    <!-- About Section (Original Color Scheme) -->
    <div class="bg-backgroundlt border-l-8 border-highlightlt p-6 md:p-8 mb-4 shadow-sm">
        <h4 class="mt-0 text-xl md:text-2xl font-bold text-highlightlt mb-3">About this event</h4>
        <div class="text-lg md:text-xl"><%= event.description %></div>
    </div>

    <!-- Location Vertical Line (High Contrast with Original Colors) -->
    <div class="relative ml-4 md:ml-8 mb-12 pt-6 pb-4">
        <div class="absolute left-0 top-0 bottom-0 w-2 bg-highlightlt rounded-full opacity-40"></div>
        <div class="pl-8 md:pl-12 group">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black text-highlightlt block mb-2">Location</span>
            <a href="https://google.com<%= encodeURIComponent(event.location) %>" 
               target="_blank" 
               class="text-2xl md:text-3xl font-bold text-highlightlt hover:opacity-80 transition-all flex flex-wrap items-center gap-3 no-underline">
                📍 <%= event.location %>
                <span class="text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity bg-highlightlt/10 px-3 py-1 rounded-lg">View Map ↗</span>
            </a>
        </div>
    </div>

    <!-- Info Grid (Original Colors, Wider Layout) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <div class="bg-backgroundlt rounded-xl py-5 px-6 flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-transparent hover:border-slate-300">
            <span class="text-xs md:text-sm uppercase tracking-wider font-bold mb-2 opacity-70">Status</span>
            <span class="text-lg md:text-xl font-medium capitalize"><%= event.status %></span>
        </div>
        <div class="bg-backgroundlt rounded-xl py-5 px-6 flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-transparent hover:border-slate-300">
            <span class="text-xs md:text-sm uppercase tracking-wider font-bold mb-2 opacity-70">Date</span>
            <span class="text-lg md:text-xl font-medium">📅 <%= event.startDate.toDateString() %></span>
        </div>
        <div class="bg-backgroundlt rounded-xl py-5 px-6 flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-transparent hover:border-slate-300">
            <span class="text-xs md:text-sm uppercase tracking-wider font-bold mb-2 opacity-70">Time</span>
            <span class="text-lg md:text-xl font-medium">⏰ <%= event.startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <div class="bg-backgroundlt rounded-xl py-5 px-6 flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-transparent hover:border-slate-300">
            <span class="text-xs md:text-sm uppercase tracking-wider font-bold mb-2 opacity-70">Organizer</span>
            <span class="text-lg md:text-xl font-medium">👤 <%= event.organizerName %></span>
        </div>
        <div class="bg-backgroundlt rounded-xl py-5 px-6 flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-transparent hover:border-slate-300 lg:col-span-2">
            <span class="text-xs md:text-sm uppercase tracking-wider font-bold mb-2 opacity-70">Attendance</span>
            <span class="text-lg md:text-xl font-medium">🎟️ <%= attendingCount %> / <%= event.maxCapacity %></span>
        </div>
    </div>

    <!-- Actions (Original Colors) -->
    <div class="flex flex-col md:flex-row justify-end items-center border-t-2 border-textlt/20 pt-10 gap-4">
        <div class="flex flex-wrap gap-4 items-center">
            <% if (canRSVP) { %>
                <%- include("partials/rsvp-button", { eventId: event.id, attendeeCount: attendingCount, maxCapacity: event.maxCapacity, rsvpStatus: null, pageError: null }) %>
            <% } %>
            
            <% if (canEdit) { %>
                <a href="/events/<%= event.id %>/edit" class="px-6 py-3 rounded-lg bg-highlightlt text-white text-lg font-medium hover:bg-highlightlt/80 transition-colors">Edit Event</a>
            <% } %>

            <% if (canEdit || session?.authenticatedUser?.role === "admin") { %>
                <button class="px-6 py-3 rounded-lg bg-highlightlt text-white text-lg font-medium hover:bg-highlightlt/80 transition-colors" 
                        hx-get="/events/<%= event.id %>/attendees" 
                        hx-target="#attendee-list-panel" 
                        type="button">
                    View Attendees
                </button>
            <% } %>
        </div>
    </div>
    
    <div id="attendee-list-panel" class="mt-8"></div>
</div>
