<div class="max-w-4xl my-10 mx-auto leading-relaxed bg-backgroundmd rounded-2xl p-6 md:p-8 shadow-2xl transition-all"
     x-data="{ 
        get relativeTime() {
            const start = new Date('<%= event.startDate.toISOString() %>');
            const now = new Date();
            const diffTime = start - now;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays < 0) return ''; 
            if (diffDays === 0) return 'Happening Today';
            if (diffDays === 1) return 'Starting Tomorrow';
            if (diffDays <= 7) return `In ${diffDays} days`;
            return ''; 
        }
     }">
    
    <!-- Responsive Header -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-4 mb-8">
        <div class="flex-1">
            <h1 class="text-4xl md:text-5xl m-0 mb-2 break-all tracking-tight font-extrabold text-slate-900"><%= event.title %></h1>
            
            <!-- Alpine.js Human Readable Time -->
            <template x-if="relativeTime">
                <div x-text="relativeTime" class="text-highlightlt font-black text-base md:text-lg uppercase tracking-widest mb-4"></div>
            </template>
            
            <div class="flex flex-wrap gap-3 items-center">
                <% if (isDraft) { %>
                    <span class="text-textlt/90 bg-amber-500/40 py-2 px-4 rounded-full text-sm md:text-base font-bold tracking-wide">⚠️ Draft</span>
                <% } %>
                <span class="bg-green-500/20 text-textlt/90 py-2 px-4 rounded-full text-sm md:text-base font-bold capitalize"><%= event.category %></span>
            </div>
        </div>
        <a href="/events" class="text-highlightlt text-base md:text-lg font-semibold hover:underline transition-all">&larr; Back to Events</a>
    </div>

    <!-- About Section (Polished Card) -->
    <div class="bg-backgroundlt border-l-8 border-highlightlt p-6 md:p-8 mb-4 rounded-r-xl shadow-sm">
        <h4 class="mt-0 text-xl md:text-2xl font-black text-highlightlt mb-3">About this event</h4>
        <div class="text-lg md:text-xl text-slate-700 leading-loose"><%= event.description %></div>
    </div>

    <!-- Location Vertical Line (High Pop & Responsive) -->
    <div class="relative ml-4 md:ml-8 mb-12 pt-6 pb-4">
        <div class="absolute left-0 top-0 bottom-0 w-2 bg-highlightlt rounded-full shadow-[0_0_15px_rgba(var(--highlight-rgb),0.5)]"></div>
        <div class="pl-8 md:pl-12 group">
            <span class="text-xs md:text-sm uppercase tracking-[0.2em] font-black text-highlightlt/80 block mb-2">Location</span>
            <a href="https://google.com<%= encodeURIComponent(event.location) %>" 
               target="_blank" 
               class="text-2xl md:text-3xl font-black text-highlightlt hover:scale-[1.01] transition-transform flex flex-wrap items-center gap-3 no-underline">
                📍 <%= event.location %>
                <span class="text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity bg-highlightlt/10 px-3 py-1 rounded-lg">View on Map ↗</span>
            </a>
        </div>
    </div>

    <!-- Grid Layout (Responsive prefixes) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <!-- Reusable Info Component Pattern -->
        <div class="bg-backgroundlt rounded-2xl py-5 px-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border-2 border-transparent hover:border-highlightlt/20">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black mb-2 opacity-60">Status</span>
            <span class="text-lg md:text-xl font-bold capitalize text-slate-800"><%= event.status %></span>
        </div>
        <div class="bg-backgroundlt rounded-2xl py-5 px-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border-2 border-transparent hover:border-highlightlt/20">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black mb-2 opacity-60">Date</span>
            <span class="text-lg md:text-xl font-bold text-slate-800">📅 <%= event.startDate.toDateString() %></span>
        </div>
        <div class="bg-backgroundlt rounded-2xl py-5 px-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border-2 border-transparent hover:border-highlightlt/20">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black mb-2 opacity-60">Time</span>
            <span class="text-lg md:text-xl font-bold text-slate-800">⏰ <%= event.startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <div class="bg-backgroundlt rounded-2xl py-5 px-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border-2 border-transparent hover:border-highlightlt/20">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black mb-2 opacity-60">Organizer</span>
            <span class="text-lg md:text-xl font-bold text-slate-800">👤 <%= event.organizerName %></span>
        </div>
        <div class="bg-backgroundlt rounded-2xl py-5 px-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border-2 border-transparent hover:border-highlightlt/20 lg:col-span-2">
            <span class="text-xs md:text-sm uppercase tracking-widest font-black mb-2 opacity-60">Attendance</span>
            <span class="text-lg md:text-xl font-bold text-slate-800">🎟️ <%= attendingCount %> / <%= event.maxCapacity %> spots filled</span>
        </div>
    </div>

    <!-- Polished Action Footer -->
    <div class="flex flex-col md:flex-row justify-end items-center border-t-4 border-textlt/10 pt-10 gap-4">
        <div class="flex flex-wrap gap-4 items-center justify-center">
            <% if (canRSVP) { %>
                <%- include("partials/rsvp-button", { eventId: event.id, attendeeCount: attendingCount, maxCapacity: event.maxCapacity, rsvpStatus: null, pageError: null }) %>
            <% } %>
            
            <% if (canEdit) { %>
                <a href="/events/<%= event.id %>/edit" class="px-8 py-3 rounded-xl bg-highlightlt text-white text-lg font-bold hover:brightness-110 hover:shadow-lg transition-all transform hover:-translate-y-0.5">Edit Event</a>
            <% } %>

            <% if (canEdit || session?.authenticatedUser?.role === "admin") { %>
                <button class="px-8 py-3 rounded-xl border-2 border-highlightlt text-highlightlt text-lg font-bold hover:bg-highlightlt hover:text-white transition-all transform hover:-translate-y-0.5" 
                        hx-get="/events/<%= event.id %>/attendees" 
                        hx-target="#attendee-list-panel" 
                        type="button">
                    Guest List
                </button>
            <% } %>
        </div>
    </div>
    
    <div id="attendee-list-panel" class="mt-10"></div>
</div>
