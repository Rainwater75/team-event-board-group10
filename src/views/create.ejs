<section class="max-w-2xl mx-auto px-4 sm:px-0">
    <div class="mb-6">
        <a href="/home" class="text-highlightlt hover:underline text-sm">Back to home</a>
        <h1 class="text-2xl sm:text-3xl font-bold text-textlt mt-2">Create New Event</h1>
        <p class="text-textlt/80 mt-1 text-sm sm:text-base">Fill out the form below to create a new event.</p>
        <a href="/events" class="text-highlightlt hover:underline text-sm">&larr; Back to events</a>
        <h1 class="text-3xl font-bold text-textlt mt-2">Create New Event</h1>
        <p class="mt-1 text-textlt/80">Fill out the form below to create a new event.</p>
    </div>

    <div id="event-form-feedback" class="mb-4">
        <% if (pageError) { %>
            <%- include("partials/error", { message: pageError }) %>
        <% } %>
    </div>

    <!-- styling subject to change to better match app theme -->
    <form
        action="/events/new"
        method="POST"
        hx-post="/events/new"
        hx-target="#event-form-feedback"
        hx-swap="innerHTML"
        class="bg-backgroundmd border border-backgroundlt shadow-lg rounded-xl px-4 sm:px-8 pt-6 pb-8 mb-4"
    >
        <div class="mb-4">
            <label for="title" class="block text-sm font-medium text-textlt mb-1">Title</label>
            <input type="text" id="title" name="title" placeholder="Enter title here..." required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt placeholder:text-textlt/50 focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
                <label for="description" class="block text-textlt text-sm font-bold mb-2">Description</label>
                <span id="characterCount" class="text-sm text-textlt/70">0/1000</span>
            </div>
            <textarea id="description" name="description" class="shadow appearance-none border rounded w-full py-2 px-3 text-textlt bg-backgrounddk border-backgroundlt leading-tight focus:outline-none focus:shadow-outline"></textarea>
            <label for="description" class="block text-sm font-medium text-textlt mb-1">Description</label>
            <textarea id="description" name="description" placeholder="Enter description here..." required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt placeholder:text-textlt/50 focus:outline-2 focus:outline-highlightlt"></textarea>
        </div>

        <div class="mb-4">
            <label for="location" class="block text-sm font-medium text-textlt mb-1">Location</label>
            <input type="text" id="location" name="location" placeholder="Enter location here..." required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt placeholder:text-textlt/50 focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="startDate" class="block text-sm font-medium text-textlt mb-1">Start Date</label>
                <input type="datetime-local" id="startDate" name="startDate" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
            </div>
            <div>
                <label for="endDate" class="block text-sm font-medium text-textlt mb-1">End Date</label>
                <input type="datetime-local" id="endDate" name="endDate" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
                <label for="maxCapacity" class="block text-sm font-medium text-textlt mb-1">Max Capacity</label>
                <input type="number" id="maxCapacity" name="maxCapacity" placeholder="0" min="1" class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt placeholder:text-textlt/50 focus:outline-2 focus:outline-highlightlt">
            </div>
            <div>
                <label for="category" class="block text-sm font-medium text-textlt mb-1">Category</label>
                <select id="category" name="category" class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk text-textlt border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
                    <option value="None">Select a category</option>
                    <option value="music">Music</option>
                    <option value="sports">Sports</option>
                    <option value="academic">Academic</option>
                </select>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
            <button type="submit" class="w-full sm:w-auto bg-highlightlt hover:bg-highlightlt/80 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
        <div class="flex items-center justify-end gap-3">
            <a href="/events" class="px-4 py-2.5 rounded-lg bg-backgroundmd text-textlt font-medium no-underline cursor-pointer hover:bg-backgroundlt">Cancel</a>
            <button type="submit" class="px-4 py-2.5 rounded-lg bg-highlightlt text-white font-medium cursor-pointer hover:bg-highlightlt/80">
                Create Event
            </button>
        </div>
    </form>

</section>

<script>
    function toDateTimeLocal(date) {
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        return local.toISOString().slice(0, 16);
    }

    function setDefaultEventTimes() {
        const startInput = document.getElementById("startDate");
        const endInput = document.getElementById("endDate");
        if (!startInput || !endInput) return;

        const now = new Date();
        if (!startInput.value) {
            startInput.value = toDateTimeLocal(new Date(now.getTime() + 60 * 60 * 1000));
        }
        if (!endInput.value) {
            endInput.value = toDateTimeLocal(new Date(now.getTime() + 2 * 60 * 60 * 1000));
        }
    }

    function descriptionCharacterCount(){
        const descriptionInput = document.getElementById("description");
        const characterCount = document.getElementById("characterCount");
        if (!descriptionInput || !characterCount) return;

        const count = descriptionInput.value.length;
        characterCount.textContent = `${count}/1000`;
    }

    document.addEventListener("DOMContentLoaded", setDefaultEventTimes);

    document.body.addEventListener("event-created", function () {
        const form = document.querySelector('form[action="/events/new"]');
        if (!form) return;
        form.reset();
        setDefaultEventTimes();
    });

    document.getElementById("description").addEventListener("input", descriptionCharacterCount);
</script>