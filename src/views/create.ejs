<section class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/home" class="text-highlightlt hover:underline text-sm">&larr; Back to home</a>
        <h1 class="text-3xl font-bold mt-2">Create New Event</h1>
        <p class="mt-1">Fill out the form below to create a new event.</p>
    </div>

    <div id="event-form-feedback" class="mb-4">
        <% if (pageError) { %>
            <%- include("partials/error", { message: pageError }) %>
        <% } %>
    </div>

    <!-- styling subject to change to better match app theme -->
    <form
        action="/events/new"
        method="POST"
        hx-post="/events/new"
        hx-target="#event-form-feedback"
        hx-swap="innerHTML"
    >
        <div class="mb-4">
            <label for="title" class="block text-sm font mb-1">Title</label>
            <input type="text" id="title" name="title" placeholder="Enter title here..." class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-4">
            <label for="description" class="block text-sm font mb-1">Description</label>
            <textarea id="description" name="description" placeholder="Enter description here..." class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt"></textarea>
        </div>

        <div class="mb-4">
            <label for="category" class="block text-sm font mb-1">Category</label>
            <select id="category" name="category" class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
                <option value="None">Select a category</option>
                <option value="music">Music</option>
                <option value="sports">Sports</option>
                <option value="academic">Academic</option>
                <!-- TODO: add more categories, probably set up a partial that lists all categories in the database -->
            </select>
        </div>

        <div class="mb-4">
            <label for="location" class="block text-sm font mb-1">Location</label>
            <input type="text" id="location" name="location" placeholder="Enter location here..." class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-4">
            <label for="startDate" class="block text-sm font mb-1">Start Date</label>
            <input type="datetime-local" id="startDate" name="startDate" class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-4">
            <label for="endDate" class="block text-sm font mb-1">End Date</label>
            <input type="datetime-local" id="endDate" name="endDate" class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-6">
            <label for="maxCapacity" class="block text-sm font mb-1">Max Capacity</label>
            <input type="number" id="maxCapacity" name="maxCapacity" placeholder="0" class="w-full px-3 py-2.5 rounded-xl bg-backgroundmd focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="flex items-center justify-between">
            <button type="submit" class="px-4 py-2.5 rounded-lg bg-highlightlt text-white font-medium cursor-pointer hover:bg-highlightlt/80">
                Create Event
            </button>
        </div>
    </form>

</section>

<script>
    function toDateTimeLocal(date) {
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        return local.toISOString().slice(0, 16);
    }

    function setDefaultEventTimes() {
        const startInput = document.getElementById("startDate");
        const endInput = document.getElementById("endDate");
        if (!startInput || !endInput) return;

        const now = new Date();
        if (!startInput.value) {
            startInput.value = toDateTimeLocal(new Date(now.getTime() + 60 * 60 * 1000));
        }
        if (!endInput.value) {
            endInput.value = toDateTimeLocal(new Date(now.getTime() + 2 * 60 * 60 * 1000));
        }
    }

    document.addEventListener("DOMContentLoaded", setDefaultEventTimes);

    document.body.addEventListener("event-created", function () {
        const form = document.querySelector('form[action="/events/new"]');
        if (!form) return;
        form.reset();
        setDefaultEventTimes();
    });
</script>