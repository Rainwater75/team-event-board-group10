<section class="max-w-6xl mx-auto" x-data="dashboardEvents()" x-init="init()">
	<div class="mb-6">
		<a href="/home" class="text-blue-600 hover:underline text-sm font-medium">← Back to home</a>
		<h1 class="text-3xl font-bold text-slate-900 mt-2">Organizer Dashboard</h1>
		<p class="text-slate-500">Your events grouped by status.</p>
	</div>

	<% if (pageError) { %>
		<div class="mb-6">
			<%- include("partials/error", { message: pageError }) %>
		</div>
	<% } %>

	<div class="mb-6">
		<a href="/events/new" class="inline-block px-4 py-2 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition">
			+ New Event
		</a>
	</div>

	<div x-show="events.length === 0" class="p-6 border border-slate-200 rounded-xl bg-white shadow-sm">
		<section class="p-6 border border-slate-200 rounded-xl bg-white shadow-sm">
			<h2 class="text-lg font-semibold text-slate-900">No events yet</h2>
			<p class="text-slate-500 mt-1">Create your first event to get started.</p>
		</section>
	</div>

	<div x-show="events.length > 0" class="space-y-5">
		<section class="p-4 border border-slate-200 rounded-xl bg-white">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold text-slate-800">Published</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-slate-100 text-slate-700" x-text="publishedEvents().length"></span>
			</div>

			<template x-if="publishedEvents().length === 0">
				<p class="text-sm text-slate-500">No published events.</p>
			</template>

			<div class="space-y-3">
				<template x-for="event in publishedEvents()" :key="event.id">
					<article class="p-3 border border-slate-200 rounded-lg bg-white">
						<h3 class="font-semibold text-slate-900" x-text="event.title"></h3>
						<p class="text-sm text-slate-500 mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm text-slate-600" x-text="event.category || 'None'"></p>
						<p class="text-sm text-slate-700 mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
					</article>
				</template>
			</div>
		</section>

		<section class="p-4 border border-slate-200 rounded-xl bg-white">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold text-slate-800">Draft</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-slate-100 text-slate-700" x-text="draftEvents().length"></span>
			</div>

			<template x-if="draftEvents().length === 0">
				<p class="text-sm text-slate-500">No draft events.</p>
			</template>

			<div class="space-y-3">
				<template x-for="event in draftEvents()" :key="event.id">
					<article class="p-3 border border-slate-200 rounded-lg bg-white">
						<h3 class="font-semibold text-slate-900" x-text="event.title"></h3>
						<p class="text-sm text-slate-500 mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm text-slate-600" x-text="event.category || 'None'"></p>
						<p class="text-sm text-slate-700 mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
					</article>
				</template>
			</div>
		</section>

		<section class="p-4 border border-slate-200 rounded-xl bg-white">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold text-slate-800">Cancelled / Past</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-slate-100 text-slate-700" x-text="cancelledOrPastEvents().length"></span>
			</div>

			<template x-if="cancelledOrPastEvents().length === 0">
				<p class="text-sm text-slate-500">No cancelled or past events.</p>
			</template>

			<div class="space-y-3">
				<template x-for="event in cancelledOrPastEvents()" :key="event.id">
					<article class="p-3 border border-slate-200 rounded-lg bg-white">
						<h3 class="font-semibold text-slate-900" x-text="event.title"></h3>
						<p class="text-sm text-slate-500 mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm text-slate-600" x-text="event.category || 'None'"></p>
						<p class="text-sm text-slate-700 mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
					</article>
				</template>
			</div>
		</section>
	</div>
</section>

<script type="application/json" id="dashboard-events-data"><%- JSON.stringify(Array.isArray(events) ? events : []) %></script>
<script>
  function dashboardEvents() {
    return {
      events: [],

      init() {
        const source = document.getElementById("dashboard-events-data");
        if (!source) return;
        try {
          this.events = JSON.parse(source.textContent || "[]");
        } catch {
          this.events = [];
        }
      },

      getStatus(event) {
				if (event?.status === "cancelled") return "cancelled";
        const start = new Date(event?.startDate);
        if (!Number.isNaN(start.getTime()) && start < new Date()) return "past";
				if (event?.status === "published") return "published";
        return "draft";
      },

      attendeeCount(event) {
        return Array.isArray(event?.attendingUsers) ? event.attendingUsers.length : 0;
      },

      formatDate(value) {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "Invalid date";
        return date.toLocaleString("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      },

      publishedEvents() {
        return this.events.filter((event) => this.getStatus(event) === "published");
      },

      draftEvents() {
        return this.events.filter((event) => this.getStatus(event) === "draft");
      },

      cancelledOrPastEvents() {
        return this.events.filter((event) => {
          const status = this.getStatus(event);
          return status === "cancelled" || status === "past";
        });
      },
    };
  }
</script>
