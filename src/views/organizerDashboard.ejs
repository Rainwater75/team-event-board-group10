<section class="max-w-6xl mx-auto" x-data="dashboardEvents()" x-init="init()" x-on:dashboard-event-status-updated.window="applyStatusUpdate($event.detail)">
	<div class="mb-6">
		<a href="/home" class="text-highlightlt hover:underline text-sm">← Back to home</a>
		<h1 class="text-3xl font-bold mt-2">Organizer Dashboard</h1>
		<p><%= session?.authenticatedUser?.role === "admin" ? "All events grouped by status." : "Your events grouped by status." %></p>
	</div>

	<div id="dashboard-feedback" class="mb-4"></div>

	<% if (pageError) { %>
		<div class="mb-6">
			<%- include("partials/error", { message: pageError }) %>
		</div>
	<% } %>

	<div class="mb-6">
		<a href="/events/new" class="px-4 py-2.5 rounded-lg bg-highlightlt text-white font-medium cursor-pointer hover:bg-highlightlt/80">
			+ New Event
		</a>
	</div>

	<div x-show="events.length === 0" class="p-6 rounded-xl bg-backgroundmd shadow-sm">
		<section class="p-6 rounded-xl bg-backgroundmd shadow-sm">
			<h2 class="text-lg font-semibold text-textlt">No events yet</h2>
			<p class="text-textlt mt-1">Create your first event to get started.</p>
		</section>
	</div>

	<!-- PUBLISHED EVENTS -->
	<div x-show="events.length > 0" class="space-y-5">
		<section class="p-4 rounded-xl bg-backgroundmd">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold">Published</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-backgroundlt" x-text="publishedEvents().length"></span>
			</div>

			<template x-if="publishedEvents().length === 0">
				<p class="text-sm">No published events.</p>
			</template>

			<div class="space-y-3">
				<template x-for="event in publishedEvents()" :key="event.id">
					<article class="p-3 rounded-lg bg-backgroundlt">
						<h3 class="font-semibold" x-text="event.title"></h3>
						<p class="text-sm mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm" x-text="event.category || 'None'"></p>
						<p class="text-sm mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<a :href="`/events/${event.id}`" class="px-4 py-2 rounded-lg bg-highlightlt text-white text-sm font-medium cursor-pointer hover:bg-highlightlt/80">View</a>
							<form :action="`/events/${event.id}/cancel`" x-bind:hx-post="`/events/${event.id}/cancel`" hx-target="#dashboard-feedback" hx-swap="innerHTML" method="POST" class="m-0" onsubmit="return confirm('Cancel this event?');">
								<button type="submit" class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium cursor-pointer hover:bg-red-700">Cancel Event</button>
							</form>
						</div>
					</article>
				</template>
			</div>
		</section>

		<!-- DRAFT EVENTS -->
		<section class="p-4 rounded-xl bg-backgroundmd">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold">Draft</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-backgroundlt" x-text="draftEvents().length"></span>
			</div>

			<template x-if="draftEvents().length === 0">
				<p class="text-sm">No draft events.</p>
			</template>

			<div class="space-y-3">
				<template x-for="event in draftEvents()" :key="event.id">
					<article class="p-3 rounded-lg bg-backgroundlt">
						<h3 class="font-semibold" x-text="event.title"></h3>
						<p class="text-sm mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm" x-text="event.category || 'None'"></p>
						<p class="text-sm mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<a :href="`/events/${event.id}`" class="px-4 py-2 rounded-lg bg-highlightlt text-white text-sm font-medium cursor-pointer hover:bg-highlightlt/80">View</a>
							<form :action="`/events/${event.id}/publish`" x-bind:hx-post="`/events/${event.id}/publish`" hx-target="#dashboard-feedback" hx-swap="innerHTML" method="POST" class="m-0">
								<button type="submit" class="px-4 py-2 rounded-lg bg-highlightlt text-white text-sm font-medium cursor-pointer hover:bg-highlightlt/80">Publish Event</button>
							</form>
						</div>
					</article>
				</template>
			</div>
		</section>

		<!-- CANCELLED / PAST EVENTS -->
		<section class="p-4 border border-slate-200 rounded-xl bg-white" x-data="{ expanded: false }">
			<div class="flex items-center justify-between mb-3">
				<div class="flex items-center gap-3 flex-1 cursor-pointer" @click="expanded = !expanded">
					<svg class="w-5 h-5 text-slate-600 transition-transform" :class="{ 'rotate-90': expanded }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
					<h2 class="text-lg font-semibold text-slate-800">Cancelled / Past</h2>
				</div>
				<span class="text-xs px-2 py-1 rounded-full bg-slate-100 text-slate-700" x-text="cancelledOrPastEvents().length"></span>
			</div>

			<div x-show="expanded" x-transition class="mt-4">
				<template x-if="cancelledOrPastEvents().length === 0">
					<p class="text-sm text-slate-500">No cancelled or past events.</p>
				</template>
		<section class="p-4 rounded-xl bg-backgroundmd">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold">Cancelled / Past</h2>
				<span class="text-xs px-2 py-1 rounded-full bg-backgroundlt" x-text="cancelledOrPastEvents().length"></span>
			</div>

			<template x-if="cancelledOrPastEvents().length === 0">
				<p class="text-sm">No cancelled or past events.</p>
			</template>

				<div class="space-y-3">
				<template x-for="event in cancelledOrPastEvents()" :key="event.id">
					<article class="p-3 rounded-lg bg-backgroundlt">
						<h3 class="font-semibold" x-text="event.title"></h3>
						<p class="text-sm mt-1" x-text="formatDate(event.startDate)"></p>
						<p class="text-sm" x-text="event.category || 'None'"></p>
						<p class="text-sm mt-2">
							Attending: <strong x-text="attendeeCount(event)"></strong> / <span x-text="event.maxCapacity"></span>
						</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<a :href="`/events/${event.id}`" class="px-4 py-2 rounded-lg bg-highlightlt text-white text-sm font-medium cursor-pointer hover:bg-highlightlt/80">View</a>
						</div>
					</article>
				</template>
				</div>
			</div>
		</section>
	</div>
</section>

<script type="application/json" id="dashboard-events-data"><%- JSON.stringify(Array.isArray(events) ? events : []) %></script>
<script>
  function dashboardEvents() {
    return {
      events: [],

      init() {
        const source = document.getElementById("dashboard-events-data");
        if (!source) return;
        try {
          this.events = JSON.parse(source.textContent || "[]");
        } catch {
          this.events = [];
        }
      },

      getStatus(event) { // determines event status ALSO CHECKS IF EVENT IS PAST
				if (event?.status === "cancelled") return "cancelled";
        const start = new Date(event?.startDate);
        if (!Number.isNaN(start.getTime()) && start < new Date()) return "past";
				if (event?.status === "published") return "published";
        return "draft";
      },

      attendeeCount(event) {
        return Array.isArray(event?.attendingUsers) ? event.attendingUsers.length : 0;
      },

      formatDate(value) {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "Invalid date";
        return date.toLocaleString("en-US", {
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      },

	  applyStatusUpdate(detail) {
		if (!detail || detail.id === undefined || !detail.status) return;

		const targetId = Number(detail.id);
		this.events = this.events.map((event) => {
		  if (Number(event.id) !== targetId) return event;
		  return { ...event, status: detail.status };
		});
	  },

      publishedEvents() {
        return this.events.filter((event) => this.getStatus(event) === "published");
      },

      draftEvents() {
        return this.events.filter((event) => this.getStatus(event) === "draft");
      },

      cancelledOrPastEvents() {
        return this.events.filter((event) => {
          const status = this.getStatus(event);
          return status === "cancelled" || status === "past";
        });
      },
    };
  }
</script>
