<section class="mb-5 p-6 rounded-2xl bg-backgroundmd shadow-lg">
  <h1 class="text-3xl font-bold mb-3">Admin User Management</h1>
  <p>
    Admin accounts can add new users, assign roles, and remove existing users from the
    in-memory user repository.
  </p>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="grid grid-cols-1 md:grid-cols-[minmax(280px,0.9fr)_minmax(0,1.1fr)] gap-5">
  <section class="p-6 rounded-2xl bg-backgroundmd shadow-lg">
    <div class="mb-4">
      <h2 class="text-xl font-semibold mb-2">Add User</h2>
      <p>Create a new admin, staff, or user account with a hashed password.</p>
    </div>

    <form class="grid gap-2.5" method="post" action="/admin/users">
      <label for="displayName" class="text-sm font-medium">Display Name</label>
      <input
        id="displayName"
        name="displayName"
        required
        class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk focus:outline-2 focus:outline-highlightlt"
      />

      <label for="email" class="text-sm font-medium">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk focus:outline-2 focus:outline-highlightlt"
      />

      <label for="password" class="text-sm font-medium">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        required
        class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk focus:outline-2 focus:outline-highlightlt"
      />

      <label for="role" class="text-sm font-medium">Role</label>
      <select
        id="role"
        name="role"
        class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk focus:outline-2 focus:outline-highlightlt"
      >
        <option value="user">User</option>
        <option value="staff">Staff</option>
        <option value="admin">Admin</option>
      </select>

      <button
        type="submit"
        class="px-4 py-2.5 rounded-lg bg-highlightlt text-white font-medium cursor-pointer hover:bg-highlightlt/80"
      >
        Add User
      </button>
    </form>
  </section>

  <section class="p-6 rounded-2xl bg-backgroundmd shadow-lg">
    <div class="mb-4">
      <h2 class="text-xl font-semibold mb-2">Existing Users</h2>
      <p>The admin can remove any account except the currently signed-in admin.</p>
    </div>

    <ul class="list-none m-0 p-0 grid gap-3.5">
      <% users.forEach((user) => { %>
        <li class="flex items-center justify-between gap-4 p-4 rounded-xl bg-backgroundlt">
          <div>
            <strong><%= user.displayName %></strong>
            <p class="text-sm mt-0.5 mb-0"><%= user.email %></p>
            <p class="text-sm mb-0">role=<%= user.role %></p>
          </div>

          <% if (session.authenticatedUser && session.authenticatedUser.userId === user.id) { %>
            <span class="text-texlt/80 bg-highlightlt/50 text-textlt/90 py-1.5 px-3.5 rounded-full text-sm font-semibold tracking-normal">
              Current Admin
            </span>
          <% } else { %>
            <form method="post" action="/admin/users/<%= user.id %>/delete" class="m-0">
              <button
                type="submit"
                class="px-4 py-2 rounded-lg bg-highlightlt text-white text-sm font-medium cursor-pointer hover:bg-highlightlt/80"
              >
                Remove
              </button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </section>
</section>
