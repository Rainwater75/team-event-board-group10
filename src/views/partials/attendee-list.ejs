<div id="attendee-list-content" class="grid gap-4">
  <% if (pageError) { %>
    <%- include("error", { message: pageError }) %>
  <% } else if (attendeeGroups) { %>

    <section class="p-4 rounded-xl bg-backgroundlt border border-highlightlt/40 shadow-md">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold">Attending</h3>
        <span class="text-xs px-2 py-1 rounded-full bg-highlightlt/30">
          <%= attendeeGroups.attending.length %>
        </span>
      </div>

      <% if (attendeeGroups.attending.length === 0) { %>
        <p class="text-sm text-textlt/80">No attendees yet.</p>
      <% } else { %>
        <ul class="grid gap-2">
          <% attendeeGroups.attending.forEach((person) => { %>
            <li class="p-3 rounded-lg bg-backgroundmd">
              <strong><%= person.displayName %></strong>
              <span class="block text-sm text-textlt/70">
                <%= person.createdAt.toLocaleString() %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="p-4 rounded-xl bg-backgroundlt border border-yellow-500/40 shadow-md">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold">Waitlisted</h3>
        <span class="text-xs px-2 py-1 rounded-full bg-yellow-500/30">
          <%= attendeeGroups.waitlisted.length %>
        </span>
      </div>

      <% if (attendeeGroups.waitlisted.length === 0) { %>
        <p class="text-sm text-textlt/80">No waitlisted attendees.</p>
      <% } else { %>
        <ul class="grid gap-2">
          <% attendeeGroups.waitlisted.forEach((person) => { %>
            <li class="p-3 rounded-lg bg-backgroundmd">
              <strong><%= person.displayName %></strong>
              <span class="block text-sm text-textlt/70">
                <%= person.createdAt.toLocaleString() %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="p-4 rounded-xl bg-backgroundlt border border-red-500/40 shadow-md">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold">Cancelled</h3>
        <span class="text-xs px-2 py-1 rounded-full bg-red-500/30">
          <%= attendeeGroups.cancelled.length %>
        </span>
      </div>

      <% if (attendeeGroups.cancelled.length === 0) { %>
        <p class="text-sm text-textlt/80">No cancelled RSVPs.</p>
      <% } else { %>
        <ul class="grid gap-2">
          <% attendeeGroups.cancelled.forEach((person) => { %>
            <li class="p-3 rounded-lg bg-backgroundmd">
              <strong><%= person.displayName %></strong>
              <span class="block text-sm text-textlt/70">
                <%= person.createdAt.toLocaleString() %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

  <% } %>
</div>