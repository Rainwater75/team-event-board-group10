<div id="attendee-list-panel" style="margin-top: 24px;">
    <% if (pageError) { %>
      <div style="margin-bottom: 12px; color: #b91c1c; background: #fee2e2; border: 1px solid #fecaca; padding: 10px 14px; border-radius: 8px; font-size: 0.9rem;">
        <%= pageError %>
      </div>
    <% } else if (attendeeGroups) { %>
      <div style="display: grid; gap: 18px;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px;">
          <h3 style="margin: 0 0 10px 0; font-size: 1rem; color: #0f172a;">Attending</h3>
          <% if (attendeeGroups.attending.length === 0) { %>
            <p style="margin: 0; color: #64748b;">No attendees yet.</p>
          <% } else { %>
            <ul style="margin: 0; padding-left: 20px; color: #334155;">
              <% attendeeGroups.attending.forEach((person) => { %>
                <li>
                  <strong><%= person.displayName %></strong>
                  <span style="color: #64748b;">— <%= person.createdAt.toLocaleString() %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
  
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px;">
          <h3 style="margin: 0 0 10px 0; font-size: 1rem; color: #0f172a;">Waitlisted</h3>
          <% if (attendeeGroups.waitlisted.length === 0) { %>
            <p style="margin: 0; color: #64748b;">No waitlisted attendees.</p>
          <% } else { %>
            <ul style="margin: 0; padding-left: 20px; color: #334155;">
              <% attendeeGroups.waitlisted.forEach((person) => { %>
                <li>
                  <strong><%= person.displayName %></strong>
                  <span style="color: #64748b;">— <%= person.createdAt.toLocaleString() %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
  
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px;">
          <h3 style="margin: 0 0 10px 0; font-size: 1rem; color: #0f172a;">Cancelled</h3>
          <% if (attendeeGroups.cancelled.length === 0) { %>
            <p style="margin: 0; color: #64748b;">No cancelled RSVPs.</p>
          <% } else { %>
            <ul style="margin: 0; padding-left: 20px; color: #334155;">
              <% attendeeGroups.cancelled.forEach((person) => { %>
                <li>
                  <strong><%= person.displayName %></strong>
                  <span style="color: #64748b;">— <%= person.createdAt.toLocaleString() %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>