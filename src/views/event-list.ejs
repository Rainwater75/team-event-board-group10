<style> /* Will move over to tailwind instead of standard CSS in future sprints, but for now this is fine for quick styling */
  /* Hover effects and mobile responsiveness */
  .btn-home:hover { background-color: #e5e7eb !important; }
  .btn-new:hover { background-color: #16a34a !important; }
  .btn-check:hover { background-color: #1d4ed8 !important; }
  
  .events-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    max-height: 70vh;
    overflow-y: auto;
    justify-content: flex-start;
  }

  .no-events {
    width: 100%;
    padding: 40px;
    text-align: center;
    background: #f9fafb;
    border-radius: 12px;
    border: 2px dashed #ccc;
    color: #6b7280;
  }

  @media (max-width: 600px) {
    .header-top { flex-direction: column; align-items: stretch !important; }
    .search-form { max-width: 100% !important; }
    .event-card { width: 100% !important; }
    .events-grid { justify-content: center; }
  }
</style>

<div style="display:flex; flex-direction:column; gap:20px; margin-bottom:20px;">
  <h1 style="margin: 0; font-size: 2.5rem; font-weight: bold;">Events!</h1>

  <div class="header-top" style="display:flex; justify-content:space-between; align-items:center; gap: 15px;">
    <div style="display:flex; gap:10px;">
      <form action="/home" method="get">
        <button type="submit" class="btn-home" style="padding:12px 20px; border-radius:8px; cursor:pointer; border:1px solid #ccc; background-color:#f3f4f6; transition: 0.2s;">Home</button>
      </form>
      
      <form action="/events/new" method="get">
        <button type="submit" class="btn-new" style="padding:12px 20px; border-radius:8px; cursor:pointer; border:none; background-color:#22c55e; color:white; font-weight:bold; transition: 0.2s;">+ Create Event</button>
      </form>
    </div>

    <form method="get" action="/events" class="search-form" style="flex-grow: 1; max-width: 600px;">
      <input type="text" name="q" value="<%= query %>" placeholder="Search events..." style="width: 100%; padding:14px; border-radius:10px; border:1px solid #ccc; font-size:16px; box-sizing: border-box;" />
    </form>
  </div>
</div>

<form method="get" action="/events/filter" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
  <select
    name="category"
    style="min-width:160px; padding:12px; border-radius:10px; border:1px solid #ccc; font-size:16px;"
  >
    <option value="">All Categories</option>
    <option value="music">Music</option>
    <option value="sports">Sports</option>
    <option value="academic">Academic</option>
    <option value="social">Social</option>
  </select>

  <input
    type="datetime-local"
    name="startAfter"
    style="min-width:220px; padding:12px; border-radius:10px; border:1px solid #ccc; font-size:16px;"
  />

  <button
    type="submit"
    style="padding:12px 18px; border-radius:10px; border:none; background-color:#2563eb; color:white; font-weight:600; cursor:pointer;"
  >
    Apply Filters
  </button>
</form>

<div class="events-grid">
  <% if (events.length > 0) { %>
    <% events.forEach(event => { %>
      <div class="event-card" style=" border:1px solid #ddd; border-radius:12px; padding:20px; width:280px; box-shadow:0 4px 10px rgba(0,0,0,0.05); display:flex; flex-direction:column; justify-content:space-between; background: white; ">
        <div>
          <h3 style="margin-top:0; margin-bottom:10px; color: #1f2937;"><%= event.title %></h3>
          <p style="font-size:14px; color:#4b5563; line-height: 1.5;">
            <%= event.description.length > 150 ? event.description.slice(0, 150) + "..." : event.description %>
          </p>
          <p style="font-size:13px; margin-top:12px; font-weight: bold; color: #6b7280;">
            📅 <%= new Date(event.startDate).toLocaleString([], {dateStyle: 'medium', timeStyle: 'short'}) %>
          </p>
        </div>
        <a href="/events/<%= event.id %>" class="btn-check" style=" margin-top:16px; text-align:center; background-color:#2563eb; color:white; padding:12px; border-radius:8px; text-decoration:none; font-weight:600; transition: 0.2s;">
          Check it Out!
        </a>
      </div>
    <% }) %>
  <% } else { %>
    <div class="no-events">
      <h3>No events found</h3>
      <p>Try searching for something else or create a new event!</p>
    </div>
  <% } %>
</div>
