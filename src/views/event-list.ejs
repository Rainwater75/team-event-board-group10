<!-- Main Container -->
<section class="mb-5 p-6 rounded-2xl bg-backgroundmd shadow-lg">
    
    <div class="flex flex-col gap-5 mb-5">
        <h1 class="m-0 text-4xl font-bold">Events!</h1>
        
        <div class="header-top flex justify-between items-center gap-4">
            <div class="flex gap-2.5">
                <form action="/events/new" method="get">
                    <button type="submit" class="btn-new gap-2.5 px-4 py-3 rounded-xl bg-highlightlt shadow-lg text-textlt no-underline transition hover:bg-highlightlt/80 cursor-pointer">+ Create Event</button>
                </form>
            </div>

            <!-- HTMX Search Input -->
            <div class="search-form flex-grow max-w-xl" x-data="{ query: '<%= query %>' }">
            <div class="relative">
                <input 
                type="text" 
                name="query" 
                x-model="query"
                placeholder="Search events..." 
                class="w-full px-3 py-2.5 pr-10 rounded-xl bg-backgrounddk focus:outline-2 focus:outline-highlightlt" 
                hx-get="/events/filter" 
                hx-trigger="keyup changed delay:500ms, search" 
                hx-target=".events-grid" 
                hx-select=".events-grid" 
                hx-push-url="true" 
                />
                
                <!-- Clear Button -->
                <button 
                type="button" 
                x-show="query.length > 0" 
                x-cloak
                @click="query = ''; $nextTick(() => { $el.previousElementSibling.dispatchEvent(new Event('search')) })"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-textlt/50 hover:text-textlt transition-colors"
                >
                <svg xmlns="http://w3.org" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                </button>
            </div>
        </div>

        </div>
    </div>

    <!-- Filter Form (Optional: Add hx-target=".events-grid" here too for inline filtering) -->
    <form hx-get="/events/filter" hx-target=".events-grid" hx-select=".events-grid" hx-push-url="true" class="flex gap-2.5 flex-wrap items-center mb-6">
        <select
            name="category"
            class="px-4 py-3 rounded-xl bg-backgroundlt shadow-lg text-textlt no-underline transition cursor-pointer"
        >
            <option value="">All Categories</option>
            <option value="music">Music</option>
            <option value="sports">Sports</option>
            <option value="academic">Academic</option>
        </select>

        <select
            name="timeframe"
            class="px-4 py-3 rounded-xl bg-backgroundlt shadow-lg text-textlt no-underline transition cursor-pointer"
        >
            <option value="all">All Upcoming</option>
            <option value="week">This Week</option>
            <option value="weekend">This Weekend</option>
        </select>

        <button
            type="submit" 
            class="px-4 py-3 rounded-xl bg-highlightlt shadow-lg text-textlt no-underline transition hover:bg-highlightlt/80 cursor-pointer"
        >
            Apply Filters
        </button>
    </form>


    <!-- The List to be updated by HTMX -->
    <div class="events-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% if (events.length > 0) { %>
            <% events.forEach(event => { %>
                <div class="event-card flex flex-col justify-between rounded-xl shadow-md bg-backgroundlt p-5">
                    <div>
                        <h3 class="font-bold text-lg mb-2.5 mt-0"><%= event.title %></h3>
                        <p class="text-sm leading-normal">
                            <%= event.description.length > 150 ? event.description.slice(0, 150) + "..." : event.description %>
                        </p>
                        <p class="text-xs mt-3 font-bold">
                            📅 <%= new Date(event.startDate).toLocaleString([], {dateStyle: 'medium', timeStyle: 'short'}) %>
                        </p>
                        <p class="text-xs mt-3 font-bold">
                            📍 <%= event.location %>
                        </p>
                    </div>
                    <a href="/events/<%= event.id %>" class="btn-check mt-4 text-center px-4 py-3 rounded-xl bg-highlightlt shadow-lg text-textlt no-underline transition hover:bg-highlightlt/80 cursor-pointer">
                        Check it Out!
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="no-events col-span-3 text-center py-10">
                <h3 class="text-xl font-semibold">No events found</h3>
                <p class="mt-2">Try searching for something else or create a new event!</p>
            </div>
        <% } %>
    </div>
</section>
