<section class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/events/<%= event.id %>" class="text-highlightlt hover:underline text-sm">&larr; Back to event</a>
        <h1 class="text-3xl font-bold mt-2">Edit Event</h1>
        <p class="mt-1">Update the form below to modify the event.</p>
    </div>

    <div id="event-form-feedback" class="mb-4">
        <% if (pageError) { %>
            <%- include("partials/error", { message: pageError }) %>
        <% } %>
    </div>

    <form 
        action="/events/<%= event.id %>/edit" 
        method="POST" 
        hx-post="/events/<%= event.id %>/edit"
        hx-target="#event-form-feedback"
        hx-swap="innerHTML"
        class="bg-backgroundmd border border-backgroundlt shadow-lg rounded-xl px-3 sm:px-8 py-5 sm:pt-6 sm:pb-8 mb-4"
    >
        <div class="mb-4">
            <label for="title" class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" id="title" value="<%= event.title %>" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="mb-4">
            <label for="description" class="block text-sm font-medium mb-1">Description</label>
            <textarea name="description" id="description" rows="4" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt"><%= event.description %></textarea>
        </div>

        <div class="mb-4">
            <label for="location" class="block text-sm font-medium mb-1">Location</label>
            <input type="text" name="location" id="location" value="<%= event.location %>" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="startDate" class="block text-sm font-medium mb-1">Start Date</label>
                <input type="datetime-local" name="startDate" id="startDate" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
            </div>
            <div>
                <label for="endDate" class="block text-sm font-medium mb-1">End Date</label>
                <input type="datetime-local" name="endDate" id="endDate" required class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="maxCapacity" class="block text-sm font-medium mb-1">Max Capacity</label>
                <input type="number" name="maxCapacity" id="maxCapacity" value="<%= event.maxCapacity %>" min="1" class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
            </div>
            <div>
                <label for="category" class="block text-sm font-medium mb-1">Category</label>
                <select name="category" id="category" class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
                    <% const categories = ["Music", "Sports", "Academic"]; %>                <option value="None">Select a category</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                </select>
            </div>
        </div>

        <div class="mb-6">
            <label for="status" class="block text-sm font-medium mb-1">Status</label>
            <select name="status" id="status" class="w-full px-3 py-2.5 rounded-xl bg-backgrounddk border border-backgroundlt focus:outline-2 focus:outline-highlightlt">
                <% const statuses = ["Draft", "Published", "Cancelled", "Past"]; %>
                <% statuses.forEach(stat => { %>
                    <option value="<%= stat %>" <%= event.status === stat ? 'selected' : '' %>><%= stat.charAt(0).toUpperCase() + stat.slice(1) %></option>
                <% }); %>
            </select>
        </div>

        <div class="flex items-center justify-end gap-3">
            <a href="/events/<%= event.id %>" class="px-4 py-2.5 rounded-lg bg-backgroundmd text-textlt font-medium no-underline cursor-pointer hover:bg-backgroundlt">Cancel</a>
            <button type="submit" class="px-4 py-2.5 rounded-lg bg-highlightlt text-white font-medium cursor-pointer hover:bg-highlightlt/80">
                Save Changes
            </button>
        </div>
    </form>
</section>

<script>
    // Helper function to format a Date object into "YYYY-MM-DDTHH:mm" local time string
    function toDateTimeLocal(date) {
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        return local.toISOString().slice(0, 16);
    }

    function setEventTimes() {
        const startInput = document.getElementById("startDate");
        const endInput = document.getElementById("endDate");
        if (!startInput || !endInput) return;
        startInput.value = toDateTimeLocal(new Date("<%= event.startDate.toISOString() %>"));
        endInput.value = toDateTimeLocal(new Date("<%= event.endDate.toISOString() %>"));
    }

    document.addEventListener("DOMContentLoaded", () => {
        setEventTimes();

        const form = document.querySelector('form[action="/events/<%= event.id %>/edit"]');
        if (!form) return;

        let isDirty = false;

        form.addEventListener('input', () => {
            isDirty = true;
        });

        form.addEventListener('submit', () => {
            isDirty = false;
        });

        window.addEventListener('beforeunload', (event) => {
            if (isDirty) {
                event.preventDefault();
                event.returnValue = '';
            }
        });
    });
</script>
