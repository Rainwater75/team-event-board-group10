<div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-4">Edit Event</h1>

    <% if (pageError) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong class="font-bold">Error:</strong>
            <span class="block sm:inline"><%= pageError %></span>
        </div>
    <% } %>

    <form 
        action="/events/<%= event.id %>/edit" 
        method="POST" 
        class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4"
        hx-post="/events/<%= event.id %>/edit"
    >
        <div class="mb-4">
            <label for="title" class="block text-gray-700 text-sm font-bold mb-2">Title</label>
            <input type="text" name="title" id="title" value="<%= event.title %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
        </div>

        <div class="mb-4">
            <label for="description" class="block text-gray-700 text-sm font-bold mb-2">Description</label>
            <textarea name="description" id="description" rows="4" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"><%= event.description %></textarea>
        </div>

        <div class="mb-4">
            <label for="location" class="block text-gray-700 text-sm font-bold mb-2">Location</label>
            <input type="text" name="location" id="location" value="<%= event.location %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="startDate" class="block text-gray-700 text-sm font-bold mb-2">Start Date</label>
                <input type="datetime-local" name="startDate" id="startDate" value="<%= event.startDate.toISOString().slice(0, 16) %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
            </div>
            <div>
                <label for="endDate" class="block text-gray-700 text-sm font-bold mb-2">End Date</label>
                <input type="datetime-local" name="endDate" id="endDate" value="<%= event.endDate.toISOString().slice(0, 16) %>" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="maxCapacity" class="block text-gray-700 text-sm font-bold mb-2">Max Capacity</label>
                <input type="number" name="maxCapacity" id="maxCapacity" value="<%= event.maxCapacity %>" min="1" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
            </div>
            <div>
                <label for="category" class="block text-gray-700 text-sm font-bold mb-2">Category</label>
                <select name="category" id="category" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                    <% const categories = ["None", "test1", "test2", "test3"]; %>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                </select>
            </div>
        </div>

        <div class="mb-6">
            <label for="status" class="block text-gray-700 text-sm font-bold mb-2">Status</label>
            <select name="status" id="status" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                <% const statuses = ["draft", "published", "cancelled", "past"]; %>
                <% statuses.forEach(stat => { %>
                    <option value="<%= stat %>" <%= event.status === stat ? 'selected' : '' %>><%= stat.charAt(0).toUpperCase() + stat.slice(1) %></option>
                <% }); %>
            </select>
        </div>

        <div class="flex justify-end space-x-2">
            <a href="/events/<%= event.id %>" class="bg-white hover:bg-blue-50 text-blue-700 border border-slate-200 py-2 px-4 rounded focus:outline-none focus:shadow-outline">Cancel</a>
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer">Save Changes</button>
        </div>
    </form>
</div>
